# ─────────────────────────────────────────────────────────────────────────────
# Bushbuyer / Bushfaller — Environment Variables Reference
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Set to your production domain in production:
# NEXTAUTH_URL=https://bushbuyer.com

# Used in email templates and share links (falls back to NEXTAUTH_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXTAUTH_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# ── OAuth Providers ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook (set to real values or leave empty to disable Facebook login)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

ENABLE_SOCIAL_LOGIN=true

# ── Database (MySQL / MariaDB) ────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bushfaller

# ── PayPal ────────────────────────────────────────────────────────────────────
# Sandbox (development) — get credentials from developer.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_MERCHANT_EMAIL=sandbox_merchant@example.com
PAYPAL_ENV=sandbox

# PAYPAL_WEBHOOK_ID — REQUIRED for webhook signature verification.
# Steps to get it:
#   1. Log in to developer.paypal.com → My Apps & Credentials → select your app
#   2. Under "Webhooks", add a webhook URL: https://yourdomain.com/api/payments/paypal/webhook
#   3. Subscribe to event: PAYMENT.CAPTURE.COMPLETED
#   4. Copy the Webhook ID shown after saving and paste it here.
# Without this value, webhook signature verification will throw and wallets
# will NOT be credited via the webhook path (they ARE credited via capture-order).
PAYPAL_WEBHOOK_ID=

# Live PayPal (production):
# PAYPAL_CLIENT_ID=your_live_client_id
# PAYPAL_CLIENT_SECRET=your_live_client_secret
# PAYPAL_BASE_URL=https://api-m.paypal.com
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_live_client_id
# PAYPAL_MERCHANT_EMAIL=your_live_paypal_email
# PAYPAL_WEBHOOK_ID=your_live_webhook_id
# PAYPAL_ENV=live

# ── Fapshi (Mobile Money — Cameroon / XAF) ────────────────────────────────────
# Get credentials from fapshi.com → Dashboard → API Settings
#
# FAPSHI_API_USER and FAPSHI_API_KEY are sent as headers on every API request.
# Without these, all Fapshi payment initiation, verification, and webhook
# processing will fail with 401/403.
#
# FAPSHI_WEBHOOK_SECRET — used for HMAC-SHA256 signature verification on webhooks.
# Set this to the secret key shown in your Fapshi webhook settings.
# Without it, ALL Fapshi webhooks will be rejected (status 403).
#
# Sandbox:
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=your_sandbox_api_user
FAPSHI_API_KEY=your_sandbox_api_key
FAPSHI_WEBHOOK_SECRET=your_fapshi_webhook_secret

# Production:
# FAPSHI_BASE_URL=https://live.fapshi.com
# FAPSHI_API_USER=your_live_api_user
# FAPSHI_API_KEY=your_live_api_key
# FAPSHI_WEBHOOK_SECRET=your_live_webhook_secret

# USD → XAF exchange rate (used for Fapshi amount conversion).
# Defaults to 600 if not set. Replace with a live rate from an FX API in production.
USD_TO_XAF_RATE=600

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Emails are silently skipped if these are empty or invalid.
# For Gmail: enable 2FA and generate an App Password at
#   myaccount.google.com/apppasswords
EMAIL_SMTP_USER=your_gmail@gmail.com
EMAIL_SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Bushbuyer <no-reply@bushbuyer.com>"

# Comma-separated list of admin email addresses that receive order notifications
ADMIN_EMAILS=admin@bushbuyer.com

# ── Admin Login (credentials-based, for admin panel access) ───────────────────
ADMIN_LOGIN_EMAIL=admin@bushbuyer.com
# SHA-256 hash of the admin password (lowercase hex).
# Generate with: echo -n "yourpassword" | sha256sum
ADMIN_LOGIN_PASSWORD_HASH=

# ── AI Chatbot (OpenRouter) ───────────────────────────────────────────────────
# Get key from openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# ── Support Contact ───────────────────────────────────────────────────────────
ADMIN_PHONE_1=+237600000000
ADMIN_PHONE_2=
